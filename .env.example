# Copy to .env.local. Keep secrets private.
VIERCYS_DB_PATH=data/viercys.sqlite
# Explicitly enable the fictional demo for npm run start. Development enables demo automatically.
VIERCYS_DEMO_MODE=true
# Optional: 12+ characters. Otherwise a random local demo manager password is generated.
VIERCYS_ADMIN_PASSWORD=
NEXT_PUBLIC_DEMO_CURRENCY=EUR
APP_URL=http://localhost:3000
# Real email requires a verified sender; blank means honest preview only.
RESEND_API_KEY=
RESEND_FROM=
RESEND_TEST_RECIPIENT=
RESEND_WEBHOOK_SECRET=
# Optional structured suggestions; blank means deterministic demo fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini